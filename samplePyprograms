# Displays the Python version
# Checks if important libraries are installed & importable
import sys
import importlib

def show_python_version():
    print("🐍 Python Version Information")
    print("-" * 30)
    print(f"Version       : {sys.version}")
    print(f"Version Info  : {sys.version_info}")
    print()


def check_libraries(libraries):
    print("📦 Library Availability Check")
    print("-" * 30)

    for lib in libraries:
        try:
            importlib.import_module(lib)
            print(f"✔ {lib} : AVAILABLE")
        except ImportError:
            print(f"✖ {lib} : NOT INSTALLED")

    print()


if __name__ == "__main__":
    show_python_version()

    important_libraries = [
        "os",
        "sys",
        "math",
        "json",
        "datetime",
        "re",
        "numpy",
        "pandas",
        "requests",
        "matplotlib"
    ]

    check_libraries(important_libraries)
